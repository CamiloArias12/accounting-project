# Root docker compose variables.
# Copy to .env:  cp .env.example .env
#
#   docker compose up -d                        -> dev  (applies the override)
#   docker compose -f docker-compose.yml up -d  -> prod

ENVIRONMENT=local

# Ports published on the host
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Postgres — mandatory, compose fails without them.
# Change the password in production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=accounting

# Auth. Outside ENVIRONMENT=local the API refuses to start with the default;
# generate one with `openssl rand -hex 32`.
# JWT_SECRET=

# Connection pool per API replica (POOL_SIZE + MAX_OVERFLOW total).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Seconds a cached chart of accounts stays valid if nothing invalidates it.
CACHE_TTL_SECONDS=300

# The company the books belong to. Configuration, not a record: the whole
# database is one company's, so a table would have exactly one row and every
# query would carry a foreign key that can only take one value.
COMPANY_NIT=900000000-5
COMPANY_LEGAL_NAME=Mi Empresa S.A.S.
# COMPANY_ADDRESS=
# COMPANY_PHONE=
# COMPANY_EMAIL=

# Where the UVT comes from. `http` reads a published table over the network;
# `simulated` answers from a hardcoded one and never touches the network, which
# is what the tests use.
UVT_SOURCE=http
UVT_SOURCE_URL=https://www.gerencie.com/uvt.html
UVT_SOURCE_TIMEOUT_SECONDS=10
# Only read by the simulated provider, to exercise the failure paths.
UVT_SOURCE_FAILURE_RATE=0.0
UVT_SOURCE_LATENCY_SECONDS=0.0

# CORS origins allowed by the API (JSON array).
# The web calls the API from the server, not the browser, so this only matters
# if an external client consumes the API directly.
CORS_ORIGINS=["http://localhost:3000"]
