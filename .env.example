# Variables del docker-compose raíz.
# Copia a .env:  cp .env.example .env
#
#   docker compose up -d                        -> dev  (aplica el override)
#   docker compose -f docker-compose.yml up -d  -> prod

ENVIRONMENT=local

# Puertos expuestos en el host
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Postgres — obligatorias, el compose falla si faltan.
# Cambia la contraseña en producción.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=accounting

# URL de la API que consume el navegador.
# En prod se hornea en el bundle al construir la imagen web.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Orígenes permitidos por CORS en la API (JSON array)
CORS_ORIGINS=["http://localhost:3000"]
